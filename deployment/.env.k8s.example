# Kubernetes/OpenShift deployment configuration
# Copy this file to ../.env and edit with your cluster details

# API Configuration (remote LLM endpoint)
API_KEY=your-api-key-here
BASE_URL=https://your-llm-endpoint.com/v1
MODEL_ID=llama-3.1-8b-instruct

# Container Image
# Format: registry/namespace/image-name:tag
# Examples:
#   - Quay.io: quay.io/your-username/websearch-agent-demo:latest
#   - Docker Hub: docker.io/your-username/websearch-agent-demo:latest
#   - OpenShift internal: image-registry.openshift-image-registry.svc:5000/your-namespace/websearch-agent-demo:latest
CONTAINER_IMAGE=quay.io/your-username/websearch-agent-demo:latest

# Optional: MLflow Tracing (cluster)
# Uncomment to enable tracing with MLflow on OpenShift/K8s
#MLFLOW_TRACKING_URI=https://mlflow.your-cluster.com
#MLFLOW_TRACKING_TOKEN=your-token-here
#MLFLOW_EXPERIMENT_NAME=websearch-agent-production
#MLFLOW_TRACKING_INSECURE_TLS=true
#MLFLOW_WORKSPACE=default
